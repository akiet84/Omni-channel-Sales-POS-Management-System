datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SalesChannel {
  id        String   @id @default(cuid())
  name      String
  type      String   // 'POS' | 'SHOPEE' | 'LAZADA' | 'TIKTOK_SHOP' | 'WEB'
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  basePrice   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skus        SKU[]
}

model SKU {
  id                String            @id @default(cuid())
  productId         String
  skuCode           String            @unique
  barcode           String            @unique
  name              String
  variantAttributes String            // JSON serialized attributes, e.g. '{"color":"Trắng","size":"L"}'
  price             Float
  costPrice         Float?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory         InventoryBalance?
  orderItems        OrderItem[]
}

model InventoryBalance {
  id        String   @id @default(cuid())
  skuId     String   @unique
  onHand    Int      @default(0) // Physical stock
  reserved  Int      @default(0) // Committed to pending online orders
  available Int      @default(0) // Salable = onHand - reserved
  updatedAt DateTime @updatedAt
  sku       SKU      @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id               String       @id @default(cuid())
  orderCode        String       @unique
  channelId        String
  customerId       String?
  cashierId        String?
  status           String       @default("COMPLETED") // 'PENDING' | 'CONFIRMED' | 'SHIPPING' | 'COMPLETED' | 'CANCELLED' | 'REFUNDED'
  paymentMethod    String       // 'CASH' | 'VIETQR'
  totalItems       Int
  subtotal         Float
  discountAmount   Float        @default(0)
  taxAmount        Float        @default(0)
  totalAmount      Float
  amountTendered   Float?
  changeGiven      Float?
  paymentReference String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  channel          SalesChannel @relation(fields: [channelId], references: [id])
  customer         Customer?    @relation(fields: [customerId], references: [id])
  items            OrderItem[]
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  skuId          String
  skuCode        String
  productName    String
  unitPrice      Float
  quantity       Int
  discountAmount Float  @default(0)
  subtotal       Float
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku            SKU    @relation(fields: [skuId], references: [id])
}
